# Copy this file to .env (which git ignores) and change what you need.
# Each setting is explained in app/security/settings.py.
PIG_ALLOWED_ORIGIN=http://localhost:5173
PIG_MAX_TEXT_CHARS=8000
PIG_DATABASE_URL=sqlite:///./pig_history.db
PIG_HISTORY_LIMIT=50
PIG_SQL_ECHO=false
PIG_INFERENCE_MODE=process
PIG_INFERENCE_WORKERS=2
PIG_INFERENCE_QUEUE=8
PIG_QUEUE_TIMEOUT_S=2.0

# Only the lab/ scripts need this: the path to your Assignment 2 folder
PIG_A2_DIR=../../COS30049_A2_Group8

# DEMO SWITCHES: only for recording the "before" half of a demo. Leave them false.
PIG_DEMO_DISABLE_SQL_DEFENCE=false
PIG_DEMO_DISABLE_DOS_DEFENCE=false
PIG_DEMO_DISABLE_NORMALISER=false
